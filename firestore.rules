rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Unstructured logs & user sessions rules
    match /login_logs/{logId} {
      allow read, write: if true;
    }
    match /chat_logs/{logId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
